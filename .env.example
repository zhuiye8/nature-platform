# =============================================================================
# Nature Platform — Environment Variables
# Copy to .env and fill in values
# =============================================================================

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://nature:nature123@localhost:5442/nature

# Redis
REDIS_URL=redis://localhost:6389

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nature
MINIO_USE_SSL=false

# Auth (JWT)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Server
SERVER_PORT=3010
# CORS: 多个 origin 用逗号分隔
CORS_ORIGIN=http://localhost:5183,http://192.168.9.170:5183

# DingTalk SSO (optional, leave empty to disable)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=http://localhost:5183/dingtalk/callback
